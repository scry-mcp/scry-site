# Caches, virtualenvs and coverage data: they regenerate, and a tracked one goes stale.
__pycache__/
*.py[co]
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
**/._*
**/.DS_Store
# The built site: generated, never tracked.
_site/
# The three repositories the publishing workflow clones to build from.
repos/
# What a maintainer's clone keeps to itself and does not publish: plans and their
# coordination logs, reports, worktrees, machine-specific settings, private notes.
/.claude/plans/
/.claude/reports/
/.claude/worktrees/
/.claude/settings.local.json
/CLAUDE.local.md
